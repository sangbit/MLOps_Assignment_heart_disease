# Files Docker should NOT send into the image build.
# Keeps the build fast and the image small, and keeps data/secrets out of the image.

.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.coverage

# training-only material (the image only serves the already-trained model)
source_data
notebooks
*.ipynb
mlflow.db
mlruns
reports
logs
tests
examples

*.pdf
.env
.DS_Store
